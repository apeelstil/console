{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"],
  "exclude": ["electron/preload.ts"]
}
